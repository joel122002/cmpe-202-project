@startuml
title <size:26><color:#142D4E>Vacation Rental</color></size>\n<size:16><color:#64748B>02 / UML deployment architecture</color></size>
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 13
skinparam shadowing false
skinparam roundCorner 10
skinparam ArrowColor #64748B
skinparam ArrowThickness 1.3
skinparam nodesep 110
skinparam ranksep 110
skinparam nodeBorderColor #52769E
skinparam nodeBackgroundColor #F0F6FD
skinparam nodeFontColor #142D4E
skinparam artifactBorderColor #94A3B8
skinparam artifactBackgroundColor #FFFFFF
skinparam artifactFontColor #142D4E
skinparam noteBackgroundColor #FFFBEB
skinparam noteBorderColor #D8B56C
skinparam noteFontColor #66542B
skinparam footerFontColor #64748B

node "Development workstation" as Workstation <<device>> #FAFCFF {
  node "Web browser" as Browser <<executionEnvironment>> #EAF3FC {
    artifact "React application\nRuns in the browser\nAPI requests via fetch()" as Client
  }
  node "Docker Engine / Compose" as Docker <<executionEnvironment>> #F8FAFC {
    node "frontend container" as Frontend <<executionEnvironment>> #EAF3FC {
      artifact "Vite development server\nNode.js 22 Alpine\nServes HTML / JS / CSS\nContainer port 5173" as Vite
    }
    node "backend container" as Backend <<executionEnvironment>> #F0FDF9 {
      artifact "Vacation Rental API\nPython 3.12 / Uvicorn / FastAPI\nSQLAlchemy + embedded SQLite\nContainer port 8000" as API
    }
    node "backend-data" as Volume <<Docker volume>> #FFF8E8 {
      artifact "vacation_rental.db\nMounted at /app/data" as File
    }
  }
}
node "Google Maps" as Maps <<external service>> #F5F3FF

Browser -- Frontend : HTTP / localhost:5173\nHTML + application assets
Browser -- Backend : HTTP / localhost:8000/api/v1\nREST / JSON + bearer token when signed in
Browser -- Maps : HTTPS\nEmbedded map
Backend -- Volume : local filesystem I/O\n/app/data/vacation_rental.db
Frontend -[hidden]right- Backend

legend bottom left
  <b>DEPLOYMENT SCOPE</b>
  Current local setup: docker-compose.yml + both Dockerfiles.
  Browser calls the API directly; frontend container serves the UI assets.
  backend-data persists the database independently of container replacement.
  Planned load balancing and PostgreSQL are not deployed by this Compose file.
endlegend
footer IMPLEMENTED DEPLOYMENT  |  Published ports: 5173:5173 and 8000:8000
@enduml
